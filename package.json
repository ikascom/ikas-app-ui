{
  "name": "ikas-app-ui",
  "version": "0.1.0",
  "private": true,
  "description": "UI components and screen patterns for building apps on ikas. A shadcn registry for any developer publishing to the ikas App Store.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev preview --port 3001",
    "build": "pnpm registry:build && pnpm manifest:build && pnpm preview:build",
    "registry:build": "node scripts/build-registry.mjs && shadcn build --output dist/r",
    "registry:validate": "shadcn registry validate",
    "manifest:build": "node scripts/build-manifest.mjs",
    "preview:build": "next build preview",
    "smoke": "node scripts/smoke-install.mjs",
    "health": "node scripts/health-check.mjs",
    "typecheck": "next typegen preview && tsc --noEmit",
    "lint": "eslint",
    "check:content": "node scripts/check-content.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "brand:build": "node scripts/build-brand.mjs"
  },
  "packageManager": "pnpm@11.9.0",
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "next": "16.3.8",
    "radix-ui": "^1.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.8.0",
    "shadcn": "^4.21.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
